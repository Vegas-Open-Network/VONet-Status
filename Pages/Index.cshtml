@page
@model IndexModel
@{
    ViewData["Title"] = "VONet Status";
}

<div class="status-page">
    <!-- Overall Status Header -->
    <div class="status-header text-center mb-4">
        <h1 class="display-4 mb-3">VONet Status</h1>
        <div class="overall-status @Model.OverallStatus.StatusClass p-3 rounded">
            <h3 class="mb-2">@Model.OverallStatus.Status</h3>
            <p class="mb-1">Overall Uptime: @Model.OverallStatus.Uptime.ToString("F2")%</p>
            <small class="text-muted">Last updated: @Model.OverallStatus.LastUpdated.ToString("MMM dd, yyyy HH:mm")</small>
        </div>
    </div>

    <!-- Services Status -->
    <div class="services-section mb-5">
        <h2 class="mb-3">System Status</h2>
        @if (Model.Services.Any())
        {
            <div class="services-grid">
                @foreach (var service in Model.Services)
                {
                    <div class="service-card p-3 mb-3 rounded border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="service-info">
                                <h5 class="mb-1">@service.Name</h5>
                                <span class="service-status @GetStatusClass(service.Status)">
                                    @GetStatusText(service.Status)
                                </span>
                                @if (!string.IsNullOrEmpty(service.Description))
                                {
                                    <p class="text-muted mb-0 mt-1"><small>@service.Description</small></p>
                                }
                            </div>
                            <div class="service-metrics text-end">
                                <div class="uptime-percentage">@service.Uptime.ToString("F1")%</div>
                                <small class="text-muted">@service.ResponseTime.ToString("F0")ms</small>
                                <br>
                                <small class="text-muted">@service.LastChecked.ToString("HH:mm")</small>
                            </div>
                        </div>
                        
                        <!-- Square Status History -->
                        @if (Model.ServiceHistory.ContainsKey(service.ServiceId))
                        {
                            <div class="status-history mt-2">
                                <div class="history-label">
                                    <small class="text-muted">30 day history</small>
                                </div>
                                <div class="history-squares">
                                    @foreach (var historyPoint in Model.ServiceHistory[service.ServiceId].TakeLast(30))
                                    {
                                        <div class="history-square @GetHistorySquareClass(historyPoint.Status)" 
                                             title="@historyPoint.Date.ToString("MMM dd"): @historyPoint.UptimePercentage.ToString("F1")% uptime"></div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                @if (Model.OverallStatus.Status.Contains("Initializing"))
                {
                    <div>
                        <strong>System Initializing</strong><br>
                        The status monitoring system is starting up. This usually happens on first run or after deployment.
                        <div class="mt-3">
                            <strong>What to do:</strong>
                            <ul class="mt-2 mb-2">
                                <li>Wait a few moments for automatic initialization</li>
                                <li>Refresh this page in 30 seconds</li>
                                <li>If you have access to the server, run a manual check to populate initial data</li>
                            </ul>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-sm btn-outline-primary" onclick="location.reload()">
                                <i class="bi bi-arrow-clockwise me-1"></i>Refresh Page
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div>
                        No services configured. Please check your configuration file and ensure the monitoring system is running.
                    </div>
                }
            </div>
        }
    </div>

    <!-- Recent Incidents -->
    <div class="incidents-section">
        <h2 class="mb-3">Recent Incidents</h2>
        @if (Model.RecentIncidents.Any())
        {
            <div class="incidents-list">
                @foreach (var incident in Model.RecentIncidents)
                {
                    <div class="incident-card p-4 mb-3 rounded border">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="mb-1">@incident.Title</h5>
                            <span class="incident-status @GetOutageStatusClass(incident.Status)">
                                @GetOutageStatusText(incident.Status)
                            </span>
                        </div>
                        <p class="text-muted mb-2">@incident.Description</p>
                        <div class="incident-details">
                            <div class="row">
                                <div class="col-md-6">
                                    <small class="text-muted">
                                        <strong>Started:</strong> @incident.StartTime.ToString("MMM dd, yyyy HH:mm")
                                        @if (incident.EndTime.HasValue)
                                        {
                                            <br><strong>Resolved:</strong> @incident.EndTime.Value.ToString("MMM dd, yyyy HH:mm")
                                        }
                                    </small>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted">
                                        <strong>Affected Services:</strong> @string.Join(", ", incident.AffectedServices)
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle me-2"></i> No recent incidents to report. All systems are running smoothly.
            </div>
        }
    </div>

    <!-- Subscribe to Updates -->
    <div class="subscribe-section mt-5 text-center">
        <h4>Stay Updated</h4>
        <p class="text-muted">Get notified about system status changes</p>
        <button class="btn btn-outline-primary" onclick="location.reload()">
            <i class="bi bi-arrow-repeat me-1"></i>Refresh Status
        </button>
        <div class="mt-3">
            <small class="text-muted">
                Auto-refresh in <span id="refresh-countdown">300</span> seconds
            </small>
        </div>
    </div>
</div>

@functions {
    private string GetStatusClass(VONet_Stats.Data.ServiceStatusType status)
    {
        return status switch
        {
            VONet_Stats.Data.ServiceStatusType.Operational => "operational",
            VONet_Stats.Data.ServiceStatusType.PartialOutage => "partial-outage",
            VONet_Stats.Data.ServiceStatusType.MajorOutage => "major-outage",
            VONet_Stats.Data.ServiceStatusType.UnderMaintenance => "maintenance",
            _ => "unknown"
        };
    }

    private string GetStatusText(VONet_Stats.Data.ServiceStatusType status)
    {
        return status switch
        {
            VONet_Stats.Data.ServiceStatusType.Operational => "Operational",
            VONet_Stats.Data.ServiceStatusType.PartialOutage => "Partial Outage",
            VONet_Stats.Data.ServiceStatusType.MajorOutage => "Major Outage",
            VONet_Stats.Data.ServiceStatusType.UnderMaintenance => "Under Maintenance",
            _ => "Unknown"
        };
    }

    private string GetHistorySquareClass(VONet_Stats.Data.ServiceStatusType status)
    {
        return status switch
        {
            VONet_Stats.Data.ServiceStatusType.Operational => "square-operational",
            VONet_Stats.Data.ServiceStatusType.PartialOutage => "square-partial",
            VONet_Stats.Data.ServiceStatusType.MajorOutage => "square-outage",
            VONet_Stats.Data.ServiceStatusType.UnderMaintenance => "square-maintenance",
            _ => "square-unknown"
        };
    }

    private string GetOutageStatusClass(VONet_Stats.Services.OutageStatusType status)
    {
        return status switch
        {
            VONet_Stats.Services.OutageStatusType.Investigating => "investigating",
            VONet_Stats.Services.OutageStatusType.Identified => "identified",
            VONet_Stats.Services.OutageStatusType.Monitoring => "monitoring",
            VONet_Stats.Services.OutageStatusType.Resolved => "resolved",
            _ => "unknown"
        };
    }

    private string GetOutageStatusText(VONet_Stats.Services.OutageStatusType status)
    {
        return status switch
        {
            VONet_Stats.Services.OutageStatusType.Investigating => "Investigating",
            VONet_Stats.Services.OutageStatusType.Identified => "Identified",
            VONet_Stats.Services.OutageStatusType.Monitoring => "Monitoring",
            VONet_Stats.Services.OutageStatusType.Resolved => "Resolved",
            _ => "Unknown"
        };
    }
}

@section Scripts {
    <script>
        // Countdown timer for auto-refresh
        let countdown = 300; // 5 minutes
        const countdownElement = document.getElementById('refresh-countdown');
        
        const timer = setInterval(() => {
            countdown--;
            countdownElement.textContent = countdown;
            
            if (countdown <= 0) {
                location.reload();
            }
        }, 1000);
    </script>
}
