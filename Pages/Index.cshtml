@page
@model IndexModel
@{
    ViewData["Title"] = "VONet Status";
}

<div class="status-page">
    <!-- Overall Status Header -->
    <header class="status-header">
        <h1>VONet Status</h1>
        <div class="overall-status @Model.OverallStatus.StatusClass">
            <h2>@Model.OverallStatus.Status</h2>
            <div class="status-details">
                <span class="uptime">Overall Uptime: @Model.OverallStatus.Uptime.ToString("F2")%</span>
                <span class="last-updated">Last updated: @Model.OverallStatus.LastUpdated.ToString("MMM dd, yyyy HH:mm")</span>
            </div>
        </div>
    </header>

    <!-- Services Status -->
    <section class="services-section">
        <h2>System Status</h2>
        @if (Model.Services.Any())
        {
            <div class="services-grid">
                @foreach (var service in Model.Services)
                {
                    <article class="service-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="service-info">
                                <h3>@service.Name</h3>
                                <span class="service-status @GetStatusClass(service.Status)">
                                    @GetStatusText(service.Status)
                                </span>
                                @if (!string.IsNullOrEmpty(service.Description))
                                {
                                    <p class="service-description">@service.Description</p>
                                }
                            </div>
                            <div class="service-metrics">
                                <div class="uptime-percentage">@service.Uptime.ToString("F1")%</div>
                                <small class="response-time">@service.ResponseTime.ToString("F0")ms</small>
                                <small class="last-checked">@service.LastChecked.ToString("HH:mm")</small>
                            </div>
                        </div>
                        
                        <!-- Status History -->
                        @if (Model.ServiceHistory.ContainsKey(service.ServiceId))
                        {
                            <div class="status-history">
                                <div class="history-label">
                                    <small>30 day history</small>
                                </div>
                                <div class="history-squares">
                                    @foreach (var historyPoint in Model.ServiceHistory[service.ServiceId].TakeLast(30))
                                    {
                                        <div class="history-square @GetHistorySquareClass(historyPoint.Status)" 
                                             title="@historyPoint.Date.ToString("MMM dd"): @historyPoint.UptimePercentage.ToString("F1")% uptime"></div>
                                    }
                                </div>
                            </div>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            @if (Model.OverallStatus.Status.Contains("Permission Error"))
            {
                <div class="alert alert-danger d-flex">
                    <i class="bi bi-exclamation-triangle-fill me-3"></i>
                    <div>
                        <strong>Permission Error</strong>
                        <p>The application cannot access or create the data folder required for operation.</p>
                        
                        <h4>To fix this issue:</h4>
                        <ol>
                            <li>Grant write permissions to the application folder</li>
                            <li>Or create an <code>App_Data</code> folder with write permissions</li>
                            <li>For IIS, grant permissions to the application pool identity</li>
                        </ol>
                        
                        <h4>IIS Permission Fix:</h4>
                        <code class="bg-dark">
                            icacls "C:\path\to\your\site\App_Data" /grant "IIS_IUSRS:(OI)(CI)M"
                        </code>
                        
                        <div class="mt-3">
                            <button class="btn btn-outline-danger" onclick="location.reload()">
                                <i class="bi bi-arrow-clockwise me-1"></i>Retry After Fixing Permissions
                            </button>
                        </div>
                    </div>
                </div>
            }
            else if (Model.OverallStatus.Status.Contains("Initializing"))
            {
                <div class="alert alert-info d-flex">
                    <i class="bi bi-info-circle me-3"></i>
                    <div>
                        <strong>System Initializing</strong>
                        <p>The status monitoring system is starting up. This usually happens on first run.</p>
                        
                        <h4>What's happening:</h4>
                        <ul>
                            <li>Creating data folder and database</li>
                            <li>Loading service configuration</li>
                            <li>Preparing monitoring system</li>
                        </ul>
                        
                        <div class="mt-3">
                            <button class="btn btn-outline-primary" onclick="location.reload()">
                                <i class="bi bi-arrow-clockwise me-1"></i>Refresh Page
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info d-flex">
                    <i class="bi bi-info-circle me-3"></i>
                    <div>
                        <strong>No Services Configured</strong>
                        <p>Please check your <code>appsettings.json</code> configuration file and add services to monitor.</p>
                        <p>Visit <a href="/check" class="alert-link">/check</a> to run initial service checks.</p>
                    </div>
                </div>
            }
        }
    </section>

    <!-- Recent Incidents -->
    <section class="incidents-section">
        <h2>Recent Incidents</h2>
        @if (Model.RecentIncidents.Any())
        {
            @foreach (var incident in Model.RecentIncidents)
            {
                <article class="incident-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h3>@incident.Title</h3>
                        <span class="incident-status @GetOutageStatusClass(incident.Status)">
                            @GetOutageStatusText(incident.Status)
                        </span>
                    </div>
                    <p class="incident-description">@incident.Description</p>
                    <div class="incident-details">
                        <div class="row">
                            <div class="col-md-6">
                                <small>
                                    <strong>Started:</strong> @incident.StartTime.ToString("MMM dd, yyyy HH:mm")
                                    @if (incident.EndTime.HasValue)
                                    {
                                        <br><strong>Resolved:</strong> @incident.EndTime.Value.ToString("MMM dd, yyyy HH:mm")
                                    }
                                </small>
                            </div>
                            <div class="col-md-6">
                                <small>
                                    <strong>Affected Services:</strong> @string.Join(", ", incident.AffectedServices)
                                </small>
                            </div>
                        </div>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="alert alert-success d-flex">
                <i class="bi bi-check-circle me-3"></i>
                <div>
                    <strong>No Recent Incidents</strong>
                    <p>All systems are running smoothly.</p>
                </div>
            </div>
        }
    </section>

    <!-- Subscribe to Updates -->
    <section class="subscribe-section">
        <h3>Stay Updated</h3>
        <p>Monitor system status and get real-time updates</p>
        <div class="subscribe-actions">
            <button class="btn btn-primary" onclick="location.reload()">
                <i class="bi bi-arrow-repeat me-1"></i>Refresh Status
            </button>
            <a href="/check" class="btn btn-outline-secondary">
                <i class="bi bi-gear me-1"></i>Run Check
            </a>
        </div>
        <div class="auto-refresh-info">
            <small>
                <i class="bi bi-clock me-1"></i>Auto-refresh in <span id="refresh-countdown">300</span> seconds
            </small>
        </div>
    </section>
</div>

@functions {
    private string GetStatusClass(VONet_Stats.Data.ServiceStatusType status)
    {
        return status switch
        {
            VONet_Stats.Data.ServiceStatusType.Operational => "operational",
            VONet_Stats.Data.ServiceStatusType.PartialOutage => "partial-outage",
            VONet_Stats.Data.ServiceStatusType.MajorOutage => "major-outage",
            VONet_Stats.Data.ServiceStatusType.UnderMaintenance => "maintenance",
            _ => "unknown"
        };
    }

    private string GetStatusText(VONet_Stats.Data.ServiceStatusType status)
    {
        return status switch
        {
            VONet_Stats.Data.ServiceStatusType.Operational => "Operational",
            VONet_Stats.Data.ServiceStatusType.PartialOutage => "Partial Outage",
            VONet_Stats.Data.ServiceStatusType.MajorOutage => "Major Outage",
            VONet_Stats.Data.ServiceStatusType.UnderMaintenance => "Under Maintenance",
            _ => "Unknown"
        };
    }

    private string GetHistorySquareClass(VONet_Stats.Data.ServiceStatusType status)
    {
        return status switch
        {
            VONet_Stats.Data.ServiceStatusType.Operational => "square-operational",
            VONet_Stats.Data.ServiceStatusType.PartialOutage => "square-partial",
            VONet_Stats.Data.ServiceStatusType.MajorOutage => "square-outage",
            VONet_Stats.Data.ServiceStatusType.UnderMaintenance => "square-maintenance",
            _ => "square-unknown"
        };
    }

    private string GetOutageStatusClass(VONet_Stats.Services.OutageStatusType status)
    {
        return status switch
        {
            VONet_Stats.Services.OutageStatusType.Investigating => "investigating",
            VONet_Stats.Services.OutageStatusType.Identified => "identified",
            VONet_Stats.Services.OutageStatusType.Monitoring => "monitoring",
            VONet_Stats.Services.OutageStatusType.Resolved => "resolved",
            _ => "unknown"
        };
    }

    private string GetOutageStatusText(VONet_Stats.Services.OutageStatusType status)
    {
        return status switch
        {
            VONet_Stats.Services.OutageStatusType.Investigating => "Investigating",
            VONet_Stats.Services.OutageStatusType.Identified => "Identified",
            VONet_Stats.Services.OutageStatusType.Monitoring => "Monitoring",
            VONet_Stats.Services.OutageStatusType.Resolved => "Resolved",
            _ => "Unknown"
        };
    }
}

@section Scripts {
    <script>
        // Countdown timer for auto-refresh
        let countdown = 300; // 5 minutes
        const countdownElement = document.getElementById('refresh-countdown');
        
        if (countdownElement) {
            const timer = setInterval(() => {
                countdown--;
                countdownElement.textContent = countdown;
                
                if (countdown <= 0) {
                    location.reload();
                }
            }, 1000);
        }

        // Add smooth scrolling for internal links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });

        // Enhance accessibility
        document.querySelectorAll('.history-square').forEach(square => {
            square.setAttribute('role', 'tooltip');
            square.setAttribute('tabindex', '0');
        });
    </script>
}
