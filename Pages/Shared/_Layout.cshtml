<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light">
    <title>@ViewData["Title"] - VONet Status</title>
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VONet_Stats.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    
    <!-- Meta tags -->
    <meta name="description" content="VONet Status Dashboard - Real-time system status monitoring">
    <meta name="theme-color" content="#28a745">
    
    <!-- Robots meta tag for admin pages -->
    @if (Context.Request.Path.StartsWithSegments("/check"))
    {
        <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    }
    
    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <i class="bi bi-shield-check text-success me-2" aria-hidden="true"></i>
                    <span>VONet Status</span>
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index" aria-current="page">
                                <i class="bi bi-house me-1" aria-hidden="true"></i>Status
                            </a>
                        </li>
                    </ul>
                    
                    <div class="navbar-text d-none d-sm-block">
                        <small class="text-muted">
                            <i class="bi bi-clock me-1" aria-hidden="true"></i>
                            <span id="current-time" aria-live="polite"></span>
                        </small>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container text-center">
            <p class="mb-1">&copy; @DateTime.Now.Year - VONet Status Dashboard</p>
            <p class="mb-0">
                <small>
                    Content is available under 
                    <a href="https://creativecommons.org/licenses/by-sa/4.0/" class="text-decoration-none" target="_blank" rel="noopener">
                        CC BY-SA 4.0
                    </a> 
                    unless otherwise noted | 
                    <a href="https://github.com/Vegas-Open-Network/VONet-Status" class="text-decoration-none" target="_blank" rel="noopener">
                        <i class="bi bi-github me-1" aria-hidden="true"></i>Source Code
                    </a>
                </small>
            </p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Core functionality -->
    <script>
        // Update current time with better formatting
        function updateTime() {
            const now = new Date();
            const timeElement = document.getElementById('current-time');
            if (timeElement) {
                timeElement.textContent = now.toLocaleTimeString([], {
                    hour: '2-digit', 
                    minute: '2-digit',
                    hour12: false
                });
            }
        }
        
        // Update time every second
        setInterval(updateTime, 1000);
        updateTime(); // Initial call
        
        // Enhanced auto-refresh for status page
        @if (Context.Request.Path == "/")
        {
            <text>
            // Auto-refresh page every 5 minutes for latest status
            let refreshTimer = setTimeout(function() {
                // Show notification before refresh
                const notification = document.createElement('div');
                notification.className = 'alert alert-info position-fixed top-0 start-50 translate-middle-x mt-3';
                notification.style.zIndex = '9999';
                notification.innerHTML = '<i class="bi bi-arrow-clockwise me-2"></i>Refreshing status...';
                document.body.appendChild(notification);
                
                setTimeout(() => location.reload(), 1000);
            }, 300000); // 5 minutes
            
            // Allow manual refresh cancellation
            document.addEventListener('visibilitychange', function() {
                if (document.hidden) {
                    clearTimeout(refreshTimer);
                } else {
                    // Restart timer when page becomes visible
                    refreshTimer = setTimeout(() => location.reload(), 300000);
                }
            });
            </text>
        }
        
        // Improve accessibility
        document.addEventListener('DOMContentLoaded', function() {
            // Add keyboard navigation for history squares
            document.querySelectorAll('.history-square').forEach(square => {
                square.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        // Show tooltip content as alert for screen readers
                        const title = this.getAttribute('title');
                        if (title) {
                            alert(title);
                        }
                    }
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>