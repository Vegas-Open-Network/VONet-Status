{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=status_history.db"
  },
  "StatusConfiguration": {
    "CheckIntervalMinutes": 5,
    "HistoryRetentionDays": 90,
    "CronToken": "change-this-to-a-secure-random-string-32-chars-minimum",
    "Services": [
      {
        "Id": "google-dns",
        "Name": "Google DNS",
        "Description": "Google Public DNS server availability",
        "Type": "PING",
        "Host": "8.8.8.8",
        "TimeoutSeconds": 5,
        "CheckInterval": 5,
        "Enabled": true
      },
      {
        "Id": "google-search",
        "Name": "Google Search",
        "Description": "Google Search engine availability",
        "Type": "HTTP",
        "Url": "https://www.google.com",
        "ExpectedStatusCode": 200,
        "TimeoutSeconds": 10,
        "CheckInterval": 5,
        "Enabled": true
      },
      {
        "Id": "github",
        "Name": "GitHub",
        "Description": "GitHub platform availability",
        "Type": "HTTP",
        "Url": "https://github.com",
        "ExpectedStatusCode": 200,
        "TimeoutSeconds": 15,
        "CheckInterval": 5,
        "Enabled": true
      },
      {
        "Id": "cloudflare-dns",
        "Name": "Cloudflare DNS",
        "Description": "Cloudflare Public DNS server",
        "Type": "PING",
        "Host": "1.1.1.1",
        "TimeoutSeconds": 5,
        "CheckInterval": 5,
        "Enabled": true
      }
    ],
    "Notifications": {
      "Email": {
        "Enabled": false,
        "SmtpServer": "smtp.example.com",
        "SmtpPort": 587,
        "Username": "",
        "Password": "",
        "ToAddresses": []
      },
      "Webhook": {
        "Enabled": false,
        "Url": "",
        "Headers": {}
      }
    }
  }
}