{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "VONet_Stats": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data\\status_history.db"
  },
  "DataDirectory": "App_Data",
  "StatusConfiguration": {
    "CheckIntervalMinutes": 5,
    "HistoryRetentionDays": 90,
    "CronToken": "",
    "Services": [
      {
        "Id": "example-service",
        "Name": "Example Service",
        "Description": "Replace with your actual services",
        "Type": "HTTP",
        "Url": "https://example.com",
        "ExpectedStatusCode": 200,
        "TimeoutSeconds": 30,
        "CheckInterval": 5,
        "Enabled": true
      }
    ],
    "Notifications": {
      "Email": {
        "Enabled": false,
        "SmtpServer": "smtp.example.com",
        "SmtpPort": 587,
        "Username": "",
        "Password": "",
        "ToAddresses": []
      },
      "Webhook": {
        "Enabled": false,
        "Url": "",
        "Headers": {}
      }
    }
  }
}